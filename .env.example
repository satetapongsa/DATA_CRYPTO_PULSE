# ==============================================================================
# CRYPTO INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Data Warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# MongoDB Raw Document Store
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=crypto_lakehouse
MONGO_USER=root
MONGO_PASSWORD=mongo_secure_pass

# Pipeline Settings
DATA_STORAGE_MODE=auto      # 'postgres_mongo' or 'local_embedded' or 'auto'
LOCAL_DATA_DIR=./data
CRYPTO_SYMBOLS=BTC,ETH,SOL,BNB,ADA,XRP
TIMEFRAME_DAYS=30
POLL_INTERVAL_SECONDS=300

# External API Endpoints (Public Free Tiers / Fallbacks)
BINANCE_API_URL=https://api.binance.com/api/v3
COINGECKO_API_URL=https://api.coingecko.com/api/v3
ENABLE_LIVE_API=true
